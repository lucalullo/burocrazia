{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurOCRazia technical recognition safety profile v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "version", "purpose", "exclusive_qualifiers", "family_context", "weak_entity_prefixes", "boilerplate"],
  "$defs": {"strings": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 120}}},
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "purpose": {"type": "string", "maxLength": 1000},
    "exclusive_qualifiers": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/strings"}},
    "family_context": {"type": "object", "maxProperties": 100, "propertyNames": {"maxLength": 120}, "additionalProperties": {"$ref": "#/$defs/strings"}},
    "weak_entity_prefixes": {"$ref": "#/$defs/strings"},
    "boilerplate": {"$ref": "#/$defs/strings"}
  }
}
