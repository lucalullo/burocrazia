{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","identity","expected_count","completed","complete","cases"],
  "properties":{
    "schema_version":{"const":1},
    "identity":{"type":"object","required":["freeze_commit","prepared_sha256","runtime_sha256","fingerprint_sha256","runner_code_sha256","registry_sha256"]},
    "expected_count":{"type":"integer","minimum":1},
    "completed":{"type":"integer","minimum":1},
    "complete":{"const":true},
    "cases":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","input_sha256","expected","observed","provenance","extraction_failed","document_correct","entity_error","version_error","candidate_recall_at_k","filled","scan_like","unknown"],
      "properties":{
        "id":{"type":"string","pattern":"^V5"},
        "input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "observed":{"type":"object","required":["match_type","document_id","family_id"]},
        "extraction_failed":{"type":"boolean"},"document_correct":{"type":"boolean"},
        "entity_error":{"type":"boolean"},"version_error":{"type":"boolean"},
        "filled":{"type":"boolean"},"scan_like":{"type":"boolean"},"unknown":{"type":"boolean"}
      }
    }}
  }
}
